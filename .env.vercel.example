# Persistent Vercel/worker queue (production)
# Set AGNES_TASK_BACKEND=supabase on the worker. Vercel auto-enables the
# Supabase backend when VERCEL=1.
AGNES_TASK_BACKEND=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=agnes-videos
AGNES_WORKER_POLL_SECONDS=2

# Existing Agnes credentials
AGNES_API_KEY=replace-me
